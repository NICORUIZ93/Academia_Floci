  "cards": [
    {
      "dot": "cyan",
      "title": "Qué aporta cada estereotipo",
      "items": [
        "@Component marca clases gestionadas por Spring.",
        "@Service expresa un rol de negocio.",
        "@Repository añade traducción de excepciones de persistencia."
      ]
    },
    {
      "dot": "amber",
      "title": "El scope no es una petición HTTP",
      "items": [
        "singleton: una instancia por contenedor Spring, reutilizada por sus consumidores.",
        "prototype: una instancia nueva cada vez que el contenedor resuelve ese bean.",
        "prototype no equivale al scope HTTP request."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dependencias web",
      "items": [
